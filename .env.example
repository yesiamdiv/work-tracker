# Neon — Dashboard → your project → Connection string (pooled).
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js. Generate the secret with:  openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application). Authorised redirect URI:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-vercel-domain/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Only these emails may sign in. Comma-separated. Everyone else is refused.
ALLOWED_EMAILS="divyamredkar495@gmail.com"

# ---------------------------------------------------------------- the model --
# Which provider the assistant uses. One of:
#   claude  openai  gemini  deepseek  openrouter  ollama
# Only the matching key below needs to be set. Defaults to claude.
AI_PROVIDER="claude"

# Optional: pin one model for both tiers. Required for openrouter in practice,
# and handy for choosing an Ollama tag. Leave empty to use the per-tier
# defaults in src/lib/ai/providers.ts.
AI_MODEL=""

# Claude — console.anthropic.com. Sonnet 5.5 for summaries, Haiku 4.5 for
# one-line rewrites.
ANTHROPIC_API_KEY=""

# ChatGPT — platform.openai.com
OPENAI_API_KEY=""

# Gemini — aistudio.google.com/apikey. Cheapest hosted option by a wide margin.
GEMINI_API_KEY=""

# DeepSeek — platform.deepseek.com
DEEPSEEK_API_KEY=""

# OpenRouter — openrouter.ai/keys. One key, many models; set AI_MODEL too.
OPENROUTER_API_KEY=""

# Ollama — needs no key, but only works where it is running, so not on Vercel.
OLLAMA_BASE_URL="http://localhost:11434/v1"


